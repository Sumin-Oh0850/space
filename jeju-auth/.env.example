# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# Supabase 대시보드 > Project Settings > API (또는 Connect 버튼)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon(publishable)_키

# https://pixabay.com/api/docs/ 로그인 후 표시되는 API Key
VITE_PIXABAY_API_KEY=여기에_pixabay_api_key
